# The build context is the project; these are the parts the image does not want.
# lerobot and image-blaster are reference checkouts, blender-mcp is fetched from
# a pinned upstream revision in the Dockerfile, and the caches are gigabytes.
lerobot/
blender-mcp/
image-blaster/
.cache/
outputs/
/envs/
.git/
.maritime/
.venv/
**/.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
*.egg-info/
.env
.env.*
MUJOCO_LOG.TXT
.DS_Store
Physical_AI_Agent/
